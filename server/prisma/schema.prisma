// Prisma schema for LogLens
// Learn more: https://pris.ly/d/prisma-schema

// The client is generated into src/generated/prisma (see prisma.config.ts for the URLs).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URLs live in prisma.config.ts (CLI) and src/db/prisma.ts (application).
datasource db {
  provider = "postgresql"
}

/// One log-analysis run: what the user submitted plus the structured
/// report produced by the AI.
model Analysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // ── Input ──
  source   String  @default("paste") // "paste" | "upload"
  fileName String? // original file name when uploaded
  rawLog   String // the full log text submitted by the user

  // ── Report: top-level fields kept as columns so we can list/filter them ──
  title    String // short summary of the main problem
  severity String // "informational" | "low" | "medium" | "high" | "critical"
  category String // e.g. "Database", "Network", "Runtime", "Build"

  // ── Report: full structured payload stored as a JSON string ──
  // (SQLite has no native JSON type, so we serialize it. It holds the
  // probable causes, debug steps, key log lines and the Markdown bug report.)
  report String

  // Who made it (see middleware/visitor.ts)
  owner      String @default("") // random id kept in the visitor's browser
  clientHash String @default("") // salted hash of the network address, for rate limits

  // Visitor's verdict on the report: true = useful, false = not useful, null = no vote.
  helpful    Boolean?
  // Secret link for a read-only copy of the report; null when not shared.
  shareToken String?  @unique

  @@index([createdAt])
  @@index([severity])
  @@index([owner])
  @@index([clientHash, createdAt])
}

/// One analysis attempt, saved before the AI is called. Failed attempts count too,
/// so a request that keeps failing cannot get past the hourly limit.
model AnalysisAttempt {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  clientHash String   @default("")

  @@index([createdAt])
  @@index([clientHash, createdAt])
}
